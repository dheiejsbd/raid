```html
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>십자가 기사단 컨트롤러</title>
    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
    <style>
        body { margin: 0; padding: 20px; background: #16161a; color: #fff; font-family: sans-serif; text-align: center; }
        .hidden { display: none; }
        input { width: 80%; padding: 12px; font-size: 18px; border-radius: 8px; border: 1px solid #777; margin: 10px 0; text-align: center; }
        button.action-btn { width: 100%; padding: 15px; margin: 8px 0; font-size: 16px; font-weight: bold; border-radius: 10px; border: none; background: #2cb67d; color: white; cursor: pointer; }
        button.opt-btn { width: 100%; padding: 16px; margin: 8px 0; font-size: 15px; border-radius: 10px; background: #242629; border: 2px solid #7f5af0; color: #fffffe; line-height: 1.4; text-align: left; }
        #boss-shout { background: #ff5470; padding: 12px; border-radius: 8px; font-weight: bold; margin-bottom: 15px; font-size: 15px; }
        #feedback { font-size: 20px; font-weight: 900; margin: 15px 0; height: 30px; }
    </style>
</head>
<body>
    <!-- 1단계: 닉네임 입력 -->
    <div id="join-view">
        <h2>⚔️ 십자가 기사단 소집</h2>
        <p>이름과 반을 입력하고 무기고에 입장하라!</p>
        <input type="text" id="nickname" placeholder="예: 중2 김믿음"><br>
        <button class="action-btn" onclick="joinGame()">입장하기</button>
    </div>

    <!-- 2단계: 퀴즈 공격 뷰 -->
    <div id="battle-view" class="hidden">
        <div id="boss-shout">보스 도발 대기 중...</div>
        <h3 id="question-text">사령관의 명령을 기다리는 중입니다...</h3>
        <div id="feedback"></div>
        <div id="options-container"></div>
    </div>

    <script>
        const socket = io();
        let currentRound = 1;

        function joinGame() {
            const name = document.getElementById('nickname').value.trim();
            if(!name) return alert('이름을 입력하세요!');
            socket.emit('join', { nickname: name });
            document.getElementById('join-view').classList.add('hidden');
            document.getElementById('battle-view').classList.remove('hidden');
        }

        socket.on('new_question', quiz => {
            currentRound = quiz.round;
            document.getElementById('boss-shout').innerText = `👿 아볼루온: "${quiz.boss_talk}"`;
            document.getElementById('question-text').innerText = quiz.question;
            document.getElementById('feedback').innerText = '';

            const container = document.getElementById('options-container');
            container.innerHTML = '';
            quiz.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'opt-btn';
                btn.innerText = `${idx + 1}. ${opt}`;
                btn.onclick = () => {
                    socket.emit('submit_answer', { round: currentRound, selected: idx });
                    // 버튼 연타 방지 0.5초 비활성화
                    btn.disabled = true;
                    setTimeout(() => btn.disabled = false, 500);
                };
                container.appendChild(btn);
            });
        });

        socket.on('attack_result', res => {
            const fb = document.getElementById('feedback');
            fb.innerText = res.msg;
            fb.style.color = res.success ? '#2cb67d' : '#ff5470';
            if (navigator.vibrate) navigator.vibrate(res.success ? [100, 50, 100] : [200]);
        });
    </script>
</body>
</html>

