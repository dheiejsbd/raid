### 3. 핵심 백엔드 코드 (`app.py`)

```python
from flask import Flask, render_template, request
from flask_socketio import SocketIO, emit

app = Flask(__name__)
app.config['SECRET_KEY'] = 'pilgrim-secret-key'
socketio = SocketIO(app, cors_allowed_origins="*", async_mode='eventlet')

# 게임 상태 관리
game_state = {
    "boss_name": "마왕 아볼루온 (Apollyon)",
    "max_hp": 10000,          # 100명 기준 (1인당 정답 시 100 데미지)
    "current_hp": 10000,
    "current_round": 1,
    "is_started": False,
    "players": {}
}

# 라운드별 퀴즈 데이터
QUIZZES = [
    {
        "round": 1,
        "boss_talk": "너는 배가 고프잖아! 돌을 떡으로 만들어 당장 채워라!",
        "question": "사탄의 유혹에 맞설 말씀의 검(μάχαιρα)을 발사하라!",
        "options": [
            "사람이 떡으로만 살 것이 아니요 하나님의 입으로 나오는 말씀으로 사느니라",
            "배고플 때는 일단 먹고 나서 기도하는 것이 상책이니라",
            "금강산도 식후경이라 모든 유혹은 식후에 물러가느니라",
            "내일 일을 염려하지 말고 지금 눈앞의 떡을 취하라"
        ],
        "answer": 0
    },
    {
        "round": 2,
        "boss_talk": "너 기독교인이라며? 성전 꼭대기에서 뛰어내려 봐! 천사가 받아줄걸?",
        "question": "교만과 시험의 도발을 벨 격파 구절은?",
        "options": [
            "믿음이 산을 옮기니 의심하지 말고 뛰어내려라",
            "기록되었으되 주 너의 하나님을 시험하지 말라",
            "천사들이 너의 발을 받쳐 돌에 부딪히지 않게 하리라",
            "보는 것이 믿는 것이니 기적을 행하라"
        ],
        "answer": 1
    },
    {
        "round": 3,
        "boss_talk": "딱 한 번만 나한테 엎드려 절해라. 세상의 인기와 쾌락을 다 줄게!",
        "question": "세상과의 타협을 날려버릴 최후의 일격!",
        "options": [
            "좋은 게 좋은 것이니 세상과 적당히 타협하라",
            "마음은 원이로되 육신이 약하니 어쩔 수 없도다",
            "주 너의 하나님께 경배하고 다만 그를 섬기라!",
            "원수를 사랑하는 마음으로 사탄과 화친하라"
        ],
        "answer": 2
    }
]

@app.route('/')
def player_view():
    return render_template('player.html')

@app.route('/display')
def display_view():
    return render_template('display.html')

# 플레이어 접속
@socketio.on('join')
def handle_join(data):
    nickname = data.get('nickname', '십자가 군병')
    game_state['players'][request.sid] = nickname
    emit('player_count_update', {'count': len(game_state['players'])}, broadcast=True)

# 관리자(진행자)의 게임 시작 및 문제 출제
@socketio.on('start_round')
def handle_start_round(data):
    round_idx = data.get('round', 1) - 1
    quiz = QUIZZES[round_idx]
    emit('new_question', quiz, broadcast=True)

# 답안 제출 및 데미지 계산
@socketio.on('submit_answer')
def handle_submit(data):
    round_idx = data.get('round') - 1
    selected = data.get('selected')
    player_name = game_state['players'].get(request.sid, '익명의 군병')

    if QUIZZES[round_idx]['answer'] == selected:
        damage = 100
        game_state['current_hp'] = max(0, game_state['current_hp'] - damage)
        
        # 메인 스크린에 타격 브로드캐스트
        emit('boss_damaged', {
            'damage': damage,
            'current_hp': game_state['current_hp'],
            'max_hp': game_state['max_hp'],
            'attacker': player_name
        }, broadcast=True)
        
        # 학생 폰에 성공 피드백
        emit('attack_result', {'success': True, 'msg': '말씀의 검 적중! -100 HP!'}, to=request.sid)
    else:
        emit('attack_result', {'success': False, 'msg': '방어막에 빗나갔습니다! 다시 조준하세요!'}, to=request.sid)

@socketio.on('disconnect')
def handle_disconnect():
    game_state['players'].pop(request.sid, None)
    emit('player_count_update', {'count': len(game_state['players'])}, broadcast=True)

if __name__ == '__main__':
    socketio.run(app, host='0.0.0.0', port=5000, debug=True)

