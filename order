        <button onclick="triggerRound(1)">1라운드 시작</button>
        <button onclick="triggerRound(2)">2라운드 시작</button>
        <button onclick="triggerRound(3)">3라운드 시작</button>
    </div>

    <script>
        const socket = io();
        const hpBar = document.getElementById('hp-bar');
        const hpText = document.getElementById('hp-text');
        const bossImg = document.getElementById('boss-img');
        const arena = document.getElementById('boss-arena');

        socket.on('player_count_update', data => document.getElementById('count').innerText = data.count);

        socket.on('boss_damaged', data => {
            const percent = (data.current_hp / data.max_hp) * 100;
            hpBar.style.width = percent + '%';
            hpText.innerText = `${data.current_hp} / ${data.max_hp} HP`;

            // 흔들림 및 데미지 플로팅
            bossImg.classList.add('shake');
            setTimeout(() => bossImg.classList.remove('shake'), 300);

