window.__raidBots ??= [];

const correctAnswers = {
  1: 0,
  2: 1,
  3: 2,
  4: 2,
};

// 봇 정답률
const accuracy = 0.7;

// 오답 선택지 수
const answerCount = 3;

for (let i = 1; i <= 100; i++) {
  const bot = io();
  window.__raidBots.push(bot);

  bot.on("connect", () => {
    bot.emit("join", {
      nickname: `테스트${i}`,
      className: "테스트반"
    });
  });

  bot.on("new_question", quiz => {
    const correct = correctAnswers[quiz.round];

    if (correct === undefined) return;

    // 정답률에 따라 정답/오답 결정
    const isCorrect = Math.random() < accuracy;

    let selected;

    if (isCorrect) {
      selected = correct;
    } else {
      // 정답을 제외한 오답 선택지 중 랜덤 선택
      const wrongAnswers = [];

      for (let answer = 0; answer < answerCount; answer++) {
        if (answer !== correct) {
          wrongAnswers.push(answer);
        }
      }

      selected = wrongAnswers[
        Math.floor(Math.random() * wrongAnswers.length)
      ];
    }

    const delay = 1000 + Math.random() * 9000;

    setTimeout(() => {
      bot.emit("submit_answer", {
        round: quiz.round,
        selected
      });
    }, delay);
  });
}